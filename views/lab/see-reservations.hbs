<html lang="en" data-theme="light"></html>
<head>
    <link rel="stylesheet" href="/css/default/homepage2.css">
    <link rel="stylesheet" href="/css/lab/see-reservations.css">
</head>


<div class="page p-6 bg-white">
    <p class="text-xl font-bold text-slate-800 mb-6">All Reservations</p>

    <div class="bg-slate-50 p-4 rounded-xl mb-6 border border-slate-100 shadow-sm">
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3 items-center">
            <select id="buildingInput" class="select select-bordered select-xs w-full column-filter">
                <option value="">Input Building</option>
                <option value="Gokongwei Building">Gokongwei Building</option>
                <option value="St. La Salle Hall">St. La Salle Hall</option>
                <option value="Don Enrique T. Yuchengco Hall">Don Enrique T. Yuchengco Hall</option>
                <option value="Br. Andrew Gonzales Hall">Br. Andrew Gonzales Hall</option>
            </select>

            <select id="roomInput" class="select select-bordered select-xs w-full column-filter">
                <option value="">Input Room</option>
            </select>

            <input id="emailInput" type="text" placeholder="Search by email" class="input input-bordered input-xs w-full column-filter">

            <input id="reservationDateInput" type="date" class="input input-bordered input-xs w-full column-filter">

            <div class="flex items-center gap-1">
                <span class="text-[10px] font-bold uppercase text-slate-400">Start</span>
                <div class="flex items-center gap-1 flex-1">
                    <select id="startHr" class="select select-bordered select-xs flex-1 time-filter">
                        <option value="">Hr</option>
                        <option value="07">7</option>
                        <option value="08">8</option>
                        <option value="09">9</option>
                        <option value="10">10</option>
                        <option value="11">11</option>
                        <option value="12">12</option>
                        <option value="13">13</option>
                        <option value="14">14</option>
                        <option value="15">15</option>
                        <option value="16">16</option>
                        <option value="17">17</option>
                        <option value="18">18</option>
                        <option value="19">19</option>
                        <option value="20">20</option>
                    </select>
                    <span class="text-slate-400 font-bold">:</span>
                    <select id="startMin" class="select select-bordered select-xs flex-1 time-filter">
                        <option value="">Min</option>
                        <option value="00">00</option>
                        <option value="30">30</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center gap-1">
                <span class="text-[10px] font-bold uppercase text-slate-400">End</span>
                <div class="flex items-center gap-1 flex-1">
                    <select id="endHr" class="select select-bordered select-xs flex-1 time-filter">
                        <option value="">Hr</option>
                        <option value="07">7</option>
                        <option value="08">8</option>
                        <option value="09">9</option>
                        <option value="10">10</option>
                        <option value="11">11</option>
                        <option value="12">12</option>
                        <option value="13">13</option>
                        <option value="14">14</option>
                        <option value="15">15</option>
                        <option value="16">16</option>
                        <option value="17">17</option>
                        <option value="18">18</option>
                        <option value="19">19</option>
                        <option value="20">20</option>
                        <option value="21">21</option>
                    </select>
                    <span class="text-slate-400 font-bold">:</span>
                    <select id="endMin" class="select select-bordered select-xs flex-1 time-filter">
                        <option value="">Min</option>
                        <option value="00">00</option>
                        <option value="30">30</option>
                    </select>
                </div>
            </div>

            <button id="resetBtn" class="btn btn-ghost btn-xs text-slate-500 hover:bg-slate-200">Reset</button>
        </div>
    </div>

    <div class="overflow-x-auto w-full px-4">
        <table id="reservationTable" class="w-full bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <thead class="bg-slate-50 border-b border-slate-100 text-center">
                <tr class="text-center">
                    <th class="py-3 text-slate-800 px-4 text-sm text-center">Building</th>
                    <th class="py-3 text-slate-800 px-4 text-sm text-center">Room</th>
                    <th class="py-3 text-slate-800 px-4 text-sm text-center">Date</th>
                    <th class="py-3 text-slate-800 px-4 text-sm text-center">Time</th>
                    <th class="py-3 text-slate-800 px-4 text-sm text-center">Reserved By</th>
                    <th class="py-3 text-slate-800 px-4 text-sm text-center">Reserved On</th>
                    <th class="py-3 text-slate-800 px-4 text-sm text-center">Reserved At</th>
                    <th class="py-3 text-slate-800 px-4 text-sm text-center">Status</th>
                    <th class="py-3 text-slate-800 px-4 text-sm text-center">Actions</th>
                </tr>
            </thead>

            <tbody id="tbody" class="text-slate-700 hidden">
                <!-- rows will be added dynamically -->
            </tbody>

            <tbody id="loadingTbody">
                <tr id="loadingRow">
                    <td colspan="9">
                        <div class="flex flex-col justify-center items-center py-8 gap-2">
                            <div class="w-8 h-8 border-4 border-gray-300 border-t-gray-500 rounded-full animate-spin"></div>
                            <span class="text-gray-500 text-sm font-medium">Loading reservations...</span>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div id="view_modal" class="fixed inset-0 z-[9999] flex items-center justify-center p-4 hidden">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm modal-backdrop"></div>

    <div class="relative z-10 w-full max-w-xl bg-white rounded-2xl shadow-2xl overflow-hidden border border-gray-100">
        <div class="bg-[#1e3a2a] px-6 py-4 flex justify-between items-center">
            <h3 class="font-bold text-white tracking-wide">Reserved Seats</h3>
            <button type="button" id="hide_view_modal"
                class="text-white/70 hover:text-white transition-transform active:scale-90">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="p-8">
            <div id="view_modal_body" class="grid grid-cols-3 gap-x-8 gap-y-6 justify-items-center max-h-[60vh] overflow-y-auto pr-2">
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/scripts/lab/see-reservations.js"></script>