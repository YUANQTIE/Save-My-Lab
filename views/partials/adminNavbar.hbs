<script>
  $(document).ready(function () {
    console.log("Navbar Script running");

    $("#home").on("click", async function (e) {
      e.preventDefault();
      try {
        window.location.href = `/admin/landing`
      } catch (err) {
        console.error("Login Error:", err);
        alert("An error occurred. Check the F12 console.");
      }
    });

    $("#reserve").on("click", async function (e) {
      e.preventDefault();
      try {
        window.location.href = `/admin/add-reservation`
      } catch (err) {
        console.error("Login Error:", err);
        alert("An error occurred. Check the F12 console.");
      }
    });

    $("#reservations_list").on("click", async function (e) {
      e.preventDefault();
      try {
        window.location.href = `/admin/see-reservations`
      } catch (err) {
        console.error("Login Error:", err);
        alert("An error occurred. Check the F12 console.");
      }
    });

    $("#edit_computer_status").on("click", async function (e) {
      e.preventDefault();
      try {
        window.location.href = `/admin/edit-computer-status`
      } catch (err) {
        console.error("Login Error:", err);
        alert("An error occurred. Check the F12 console.");
      }
    });

    $("#see_broken_computers").on("click", async function (e) {
      e.preventDefault();
      try {
        window.location.href = `/admin/see-broken-computers`
      } catch (err) {
        console.error("Login Error:", err);
        alert("An error occurred. Check the F12 console.");
      }
    });

    $("#settingsBtn").on("click", async function (e) {
      e.preventDefault();
      try {
          window.location.href = "/admin/forgot-admin";
        } catch (err) {
            console.error("Logout failed:", err);
        }
    });

    $("#logoutBtn").on("click", async function (e) {
      e.preventDefault();
      try {
        const res = await fetch("/admin/logout");
            if (res.ok) {
                window.location.href = "/";
            }
        } catch (err) {
            console.error("Logout failed:", err);
        }
    });
  })
</script>