<div>
    <main class="flex-1 p-4 md:p-10 lg:p-16">
        {{!-- Filter Search --}}
        <div class="flex flex-wrap items-center mb-8">
            <div class="relative flex-grow max-w-8xl">
                {{!-- Filter Dropdown Menu --}}
                <div class="bg-slate-50 p-4 px-4 rounded-xl mb-6 border border-slate-100 shadow-sm">
                    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-12 items-center">
                        <select id="buildingInput" class="ml-4 select select-bordered select-xs w-full column-filter">
                            <option value="">Input Building</option>
                            <option value="Gokongwei Building">Gokongwei Building</option>
                            <option value="St. La Salle Hall">St. La Salle Hall</option>
                            <option value="Don Enrique T. Yuchengco Hall">Don Enrique T. Yuchengco Hall</option>
                            <option value="Br. Andrew Gonzales Hall">Br. Andrew Gonzales Hall</option>
                        </select>

                        <select id="roomInput" class="select select-bordered select-xs w-full column-filter">
                            <option value="">Input Room</option>
                        </select>

                        <input id="reservationDateInput" type="date"
                            class="input input-bordered input-xs w-full column-filter">

                        <div class="flex items-center gap-1">
                            <span class="text-[10px] font-bold uppercase text-slate-400">Start</span>
                            <div class="flex items-center gap-1 flex-1">
                                <select id="startHr" class="select select-bordered select-xs flex-1 time-filter">
                                    <option value="">Hr</option>
                                    <option value="07">7</option>
                                    <option value="08">8</option>
                                    <option value="09">9</option>
                                    <option value="10">10</option>
                                    <option value="11">11</option>
                                    <option value="12">12</option>
                                    <option value="13">13</option>
                                    <option value="14">14</option>
                                    <option value="15">15</option>
                                    <option value="16">16</option>
                                    <option value="17">17</option>
                                    <option value="18">18</option>
                                    <option value="19">19</option>
                                    <option value="20">20</option>
                                </select>
                                <span class="text-slate-400 font-bold">:</span>
                                <select id="startMin" class="select select-bordered select-xs flex-1 time-filter">
                                    <option value="">Min</option>
                                    <option value="00">00</option>
                                    <option value="30">30</option>
                                </select>
                            </div>
                        </div>

                        <div class="flex items-center gap-1">
                            <span class="text-[10px] font-bold uppercase text-slate-400">End</span>
                            <div class="flex items-center gap-1 flex-1">
                                <select id="endHr" class="select select-bordered select-xs flex-1 time-filter">
                                    <option value="">Hr</option>
                                    <option value="07">7</option>
                                    <option value="08">8</option>
                                    <option value="09">9</option>
                                    <option value="10">10</option>
                                    <option value="11">11</option>
                                    <option value="12">12</option>
                                    <option value="13">13</option>
                                    <option value="14">14</option>
                                    <option value="15">15</option>
                                    <option value="16">16</option>
                                    <option value="17">17</option>
                                    <option value="18">18</option>
                                    <option value="19">19</option>
                                    <option value="20">20</option>
                                    <option value="21">21</option>
                                </select>
                                <span class="text-slate-400 font-bold">:</span>
                                <select id="endMin" class="select select-bordered select-xs flex-1 time-filter">
                                    <option value="">Min</option>
                                    <option value="00">00</option>
                                    <option value="30">30</option>
                                </select>
                            </div>
                        </div>

                        <button id="resetBtn"
                            class="btn btn-ghost w-[70px] h-[30px] btn-xs text-slate-500 hover:bg-slate-200 ml-64">Reset</button>
                    </div>
                </div>
                {{!-- Table --}}
                <div class="w-full bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table id="table" class="text-center w-full text-sm text-left border-collapse">
                            <thead class="text-center bg-slate-50 border-b border-slate-100">
                                <tr>
                                    <th class="px-4 py-4 font-bold text-slate-600">Building</th>
                                    <th class="px-4 py-4 font-bold text-slate-600">Room</th>
                                    <th class="px-4 py-4 font-bold text-slate-600">Date</th>
                                    <th class="px-4 py-4 font-bold text-slate-600">Time</th>
                                    <th class="px-4 py-4 font-bold text-slate-600">Date Created</th>
                                    <th class="px-4 py-4 font-bold text-slate-600">Time Created</th>
                                    <th class="px-4 py-4 font-bold text-slate-600">Status</th>
                                    <th class="px-4 py-4 font-bold text-slate-600">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tbody" class="hidden">
                            </tbody>

                            <tbody id="loadingTbody">
                                <tr id="loadingRow">
                                    <td colspan="9">
                                        <div class="flex flex-col justify-center items-center py-8 gap-2">
                                            <div
                                                class="w-8 h-8 border-4 border-gray-300 border-t-gray-500 rounded-full animate-spin">
                                            </div>
                                            <span class="text-gray-500 text-sm font-medium">Loading
                                                reservations...</span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div id="noReservations" class="hidden mt-5 flex text-gray-500 font-bold items-center justify-center">
                    No Reservations Found
                </div>
            </div>
    </main>
</div>
{{!-- Modal for View Seats --}}
<div id="view_modal" class="fixed inset-0 z-[9999] flex items-center justify-center p-4 hidden">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm modal-backdrop"></div>

    <div class="relative z-10 w-full max-w-sm bg-white rounded-2xl shadow-2xl overflow-hidden border border-gray-100">
        <div class="bg-[#1e3a2a] px-6 py-4 flex justify-between items-center">
            <h3 class="font-bold text-white tracking-wide">Reserved Seats</h3>
            <button type="button" id="hide_view_modal"
                class="text-white/70 hover:text-white transition-transform active:scale-90">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="p-8">
            <div id="view_modal_body" class="flex flex-wrap gap-3 justify-center">
            </div>

            <div class="mt-8 flex justify-center">
                <button id="confirm_okay" type="button"
                    class="w-full bg-[#1e3a2a] hover:bg-[#2d523d] text-white font-bold py-3 px-6 rounded-xl transition-all shadow-md active:translate-y-0.5">
                    Got it
                </button>
            </div>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/scripts/user/view-reservations.js"></script>